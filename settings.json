{
  "env": {
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(pnpm *)",
      "Bash(git diff *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(python3 *)",
      "Bash(node *)",
      "Bash(npx *)",
      "Bash(docker ps *)",
      "Bash(docker start *)",
      "Bash(docker exec *)",
      "Bash(which *)",
      "Bash(ssh *)",
      "Bash(gh *)",
      "Bash(tsc *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod *)",
      "Bash(touch *)",
      "Bash(mkdir *)",
      "Edit",
      "Read",
      "Write",
      "Glob",
      "Grep",
      "Agent",
      "Skill",
      "mcp__personal-rag__search_personal_knowledge",
      "mcp__personal-rag__get_career_overview",
      "mcp__personal-rag__search_by_doc_type",
      "mcp__personal-rag__search_wiki",
      "mcp__filesystem__*",
      "mcp__github__*",
      "mcp__turicks-brain__*",
      "mcp__ollama__generate",
      "mcp__ollama__embed",
      "mcp__ollama__classify",
      "mcp__ollama__health"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)"
    ],
    "defaultMode": "plan"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/pushkarverma/.claude/hooks/filter-output.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/pushkarverma/Projects/turicks-brain-rag/scripts/stop-hook.sh"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "composio-personal": {
      "command": "node",
      "args": ["/Users/pushkarverma/.claude/composio-mcp-entity.mjs"],
      "env": {
        "COMPOSIO_API_KEY": "$COMPOSIO_API_KEY",
        "COMPOSIO_ENTITY_ID": "personal-account",
        "COMPOSIO_APPS": "INSTAGRAM,LINKEDIN"
      }
    },
    "composio-turicks": {
      "command": "node",
      "args": ["/Users/pushkarverma/.claude/composio-mcp-entity.mjs"],
      "env": {
        "COMPOSIO_API_KEY": "$COMPOSIO_API_KEY",
        "COMPOSIO_ENTITY_ID": "turicks-internal",
        "COMPOSIO_APPS": "LINKEDIN"
      }
    },
    "composio-default": {
      "command": "node",
      "args": ["/Users/pushkarverma/.claude/composio-mcp-entity.mjs"],
      "env": {
        "COMPOSIO_API_KEY": "$COMPOSIO_API_KEY",
        "COMPOSIO_ENTITY_ID": "default",
        "COMPOSIO_APPS": "GMAIL,GOOGLEDRIVE"
      }
    },
    "composio-turicks-work": {
      "command": "node",
      "args": ["/Users/pushkarverma/.claude/composio-mcp-entity.mjs"],
      "env": {
        "COMPOSIO_API_KEY": "$COMPOSIO_API_KEY",
        "COMPOSIO_ENTITY_ID": "turicks-work",
        "COMPOSIO_APPS": "GMAIL,GOOGLEDRIVE"
      }
    },
    "composio-personal-google": {
      "command": "node",
      "args": ["/Users/pushkarverma/.claude/composio-mcp-entity.mjs"],
      "env": {
        "COMPOSIO_API_KEY": "$COMPOSIO_API_KEY",
        "COMPOSIO_ENTITY_ID": "personal-google",
        "COMPOSIO_APPS": "GMAIL"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/Users/pushkarverma/Projects/founderos"]
    },
    "ollama": {
      "command": "/Users/pushkarverma/Projects/ollama-mcp-server/venv/bin/python3",
      "args": ["/Users/pushkarverma/Projects/ollama-mcp-server/server.py"],
      "env": {
        "OLLAMA_URL": "http://localhost:11434"
      }
    },
    "safari": {
      "command": "npx",
      "args": ["safari-mcp"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "$GITHUB_PERSONAL_ACCESS_TOKEN"
      }
    },
    "nano-banana": {
      "command": "/Users/pushkarverma/.nvm/versions/node/v22.22.1/bin/nano-banana-mcp",
      "env": {
        "GEMINI_API_KEY": "$GEMINI_API_KEY"
      }
    }
  },
  "effort": "medium",
  "alwaysThinkingEnabled": true,
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  }
}
